FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY src/Kubernet.Api/Kubernet.Api.csproj src/Kubernet.Api/
RUN dotnet restore src/Kubernet.Api/Kubernet.Api.csproj

COPY src/Kubernet.Api/ src/Kubernet.Api/
RUN dotnet publish src/Kubernet.Api/Kubernet.Api.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

ENV ASPNETCORE_URLS=http://+:8080

COPY --from=build /app/publish .

EXPOSE 8080

ENTRYPOINT ["dotnet", "Kubernet.Api.dll"]
